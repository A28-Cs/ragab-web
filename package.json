{
  "name": "ragab-pharmacy-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "typecheck": "npm --prefix apps/web run typecheck 2>/dev/null || tsc -p apps/web/tsconfig.json --noEmit && tsc -p packages/server/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p packages/server/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "npm --prefix packages/server run test",
    "test:integration": "npm --prefix packages/server run test:integration",
    "db:generate": "npm --prefix packages/server run db:generate",
    "db:migrate": "npm --prefix packages/server run db:migrate",
    "db:seed": "npm --prefix packages/server run db:seed",
    "worker": "npm --prefix packages/server run worker",
    "lint": "npm --prefix packages/server run lint",
    "test:e2e": "playwright test",
    "ingest:fetch": "npm --prefix packages/server run ingest:fetch",
    "ingest:plan": "npm --prefix packages/server run ingest:plan",
    "catalog:import": "npm --prefix packages/server run catalog:import --"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "jose": "^5.10.0"
  }
}
