{
  "name": "@ragab/server",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "worker": "tsx --env-file-if-exists=../../.env watch src/jobs/worker.ts",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration.test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "ingest:fetch": "tsx --env-file-if-exists=../../.env src/ingest/cli.ts fetch",
    "ingest:plan": "tsx --env-file-if-exists=../../.env src/ingest/cli.ts plan",
    "ingest:fetch:chefaa": "tsx --env-file-if-exists=../../.env src/ingest/cli.ts fetch-chefaa",
    "ingest:plan:chefaa": "tsx --env-file-if-exists=../../.env src/ingest/cli.ts plan-chefaa",
    "catalog:import": "tsx --env-file-if-exists=../../.env src/db/import/run.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./db": "./src/db/index.ts",
    "./modules/*": "./src/modules/*/index.ts",
    "./http": "./src/http/index.ts",
    "./http/*": "./src/http/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./security/*": "./src/security/*.ts",
    "./security/permissions": "./src/security/permissions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "bullmq": "^5.81.4",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.2",
    "firebase-admin": "^14.4.0",
    "hash-wasm": "^4.12.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.6",
    "otplib": "^12.0.1",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4",
    "ulid": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
