# ============================================================================
# Ragab environment configuration — NAMES ONLY. Copy to .env and fill values.
# Never commit .env. Secrets must be 32+ bytes of high entropy.
# ============================================================================

# --- Public (safe to expose to the browser bundle) ---
NEXT_PUBLIC_APP_NAME="رجب - Ragab Pharmacy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="/api/v1"
NEXT_PUBLIC_STORE_LOCATION="قرية عليم – مركز أبو حماد – محافظة الشرقية – مصر"
NEXT_PUBLIC_STORE_PHONE="+20 10 1234 5678"
NEXT_PUBLIC_WHATSAPP_NUMBER="+201012345678"

# --- Runtime ---
NODE_ENV="development"
LOG_LEVEL="info"

# --- Database ---
DATABASE_URL="postgres://ragab:ragab_dev_pw@localhost:5434/ragab"
DATABASE_POOL_MAX="10"
POSTGRES_USER="ragab"
POSTGRES_PASSWORD="ragab_dev_pw"
POSTGRES_DB="ragab"

# --- Redis ---
REDIS_URL="redis://localhost:6380"

# --- Session & CSRF (generate: openssl rand -base64 48) ---
SESSION_SECRET="change-me-32-bytes-minimum-of-entropy-000"
CSRF_SECRET="change-me-32-bytes-minimum-of-entropy-111"
SESSION_TTL_SECONDS="604800"
SESSION_ABSOLUTE_TTL_SECONDS="2592000"

# --- Paymob (§17/§18/§20) ---
PAYMOB_API_KEY=""
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_BASE_URL="https://accept.paymob.com"
PAYMOB_WEBHOOK_TOLERANCE_SECONDS="300"

# --- Object storage (MinIO/S3) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="ragab-uploads"
S3_PUBLIC_URL="http://localhost:9000/ragab-uploads"

# --- Email (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ragab <no-reply@ragab.local>"

# --- Feature toggles ---
RATE_LIMIT_ENABLED="true"

# --- Mobile app (§26/§47/§25). Native clients authenticate via Bearer token. ---
SESSION_MOBILE_ABSOLUTE_TTL_SECONDS="7776000"   # 90d absolute cap for native sessions
MOBILE_MIN_SUPPORTED_VERSION="1.0.0"            # below this, the app forces/soft-prompts an update
MOBILE_LATEST_VERSION="1.0.0"
MOBILE_FORCE_UPDATE="false"
# Deep-link association (fill once the app is registered with the stores)
MOBILE_ANDROID_PACKAGE="sa.nextdigital.ragab"
MOBILE_ANDROID_SHA256=""                         # comma-separated signing-cert SHA-256 fingerprints
MOBILE_IOS_APP_ID=""                             # TEAMID.sa.nextdigital.ragab
